{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.satish.invalid/explanation-packet-v1.schema.json",
  "title": "ExplanationPacketV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "explanation_id", "risk_packet_id", "detector_evidence", "reference_baseline", "ranked_feature_contributions", "risk_factor_decomposition", "deterministic_policy_trace", "feasible_counterfactual", "limitations", "explanation_implementation_version"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\."},
    "explanation_id": {"type": "string", "minLength": 1},
    "risk_packet_id": {"type": "string", "minLength": 1},
    "detector_evidence": {"type": "object"},
    "reference_baseline": {"type": "object"},
    "ranked_feature_contributions": {"type": "array", "items": {"type": "object"}},
    "risk_factor_decomposition": {"type": "object"},
    "deterministic_policy_trace": {"type": "object"},
    "feasible_counterfactual": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "explanation_implementation_version": {"type": "string", "minLength": 1}
  }
}
