{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.satish.invalid/recommendation-record-v1.schema.json",
  "title": "RecommendationRecordV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "recommendation_id", "risk_packet_id", "explanation_id", "action", "rule_set_version", "rule_ids", "disposition", "operator_identity", "disposition_timestamp", "reason_code", "rationale", "second_reviewer_identity"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\."},
    "recommendation_id": {"type": "string", "minLength": 1},
    "risk_packet_id": {"type": "string", "minLength": 1},
    "explanation_id": {"type": "string", "minLength": 1},
    "action": {"enum": ["NOMINAL", "COOLDOWN", "SAFE_MODE", "ALERT_ONLY"]},
    "rule_set_version": {"type": "string", "minLength": 1},
    "rule_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "disposition": {"enum": ["PENDING", "ACCEPTED", "REJECTED", "DEFERRED"]},
    "operator_identity": {"type": ["string", "null"]},
    "disposition_timestamp": {"type": ["string", "null"], "format": "date-time"},
    "reason_code": {"type": ["string", "null"]},
    "rationale": {"type": ["string", "null"]},
    "second_reviewer_identity": {"type": ["string", "null"]}
  }
}
