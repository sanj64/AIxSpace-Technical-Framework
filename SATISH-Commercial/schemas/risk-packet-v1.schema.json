{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.satish.invalid/risk-packet-v1.schema.json",
  "title": "RiskPacketV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "run_id", "event_id", "timestamp", "subsystem", "detector_identity", "artifact_hash", "config_hash", "feature_schema_hash", "score", "threshold", "margin", "anomaly", "data_quality_flags", "system_mode"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\."},
    "packet_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "subsystem": {"type": "string", "minLength": 1},
    "detector_identity": {"type": "string", "minLength": 1},
    "artifact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "config_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "feature_schema_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "score": {"type": ["number", "null"]},
    "threshold": {"type": ["number", "null"]},
    "margin": {"type": ["number", "null"]},
    "anomaly": {"type": "boolean"},
    "data_quality_flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "system_mode": {"enum": ["NORMAL", "DEGRADED"]}
  }
}
