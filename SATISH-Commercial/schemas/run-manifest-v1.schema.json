{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.satish.invalid/run-manifest-v1.schema.json",
  "title": "RunManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "created_at", "dataset_ids", "split_boundaries", "code_commit", "environment", "sbom_hash", "artifact_hash", "config_pack_hash", "feature_schema_hash", "seed", "metrics", "generated_output_hashes"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\."},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "dataset_ids": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "split_boundaries": {"type": "object"},
    "code_commit": {"type": "string", "minLength": 1},
    "environment": {"type": "object", "additionalProperties": {"type": "string"}},
    "sbom_hash": {"type": "string", "minLength": 1},
    "artifact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "config_pack_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "feature_schema_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "seed": {"type": "integer"},
    "metrics": {"type": "object"},
    "generated_output_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
  }
}
